site_name: '{{ project_name }}'
theme:
  variant: classic
  palette:
    primary: 'deep purple'
    accent: 'deep purple'
  icon:
    logo: material/duck

markdown_extensions:
  - abbr
  - admonition
  - def_list
  - toc:
      permalink: true
  - pymdownx.snippets:
      check_paths: true
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
  - pymdownx.emoji:
      emoji_index: !!python/name:zensical.extensions.emoji.twemoji
      emoji_generator: !!python/name:zensical.extensions.emoji.to_svg

plugins:
  - tags
